# Configurações da aplicação XLS Fusion

# JWT Secret para autenticação do backend
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=5m

# Porta onde a aplicação rodará
PORT=8080

# Conexão MongoDB
# Para desenvolvimento local: mongodb://localhost:27017/xls_fusion
# Para Docker: mongodb://root:example@mongo:27017/xls_fusion?authSource=admin
MONGO_URI=mongodb://localhost:27017/xls_fusion

# Ambiente da aplicação (development/production)
NODE_ENV=development

# Indica se está rodando em container Docker
DOCKER_CONTAINER=false
