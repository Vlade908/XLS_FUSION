# Configurações da aplicação XLS Fusion

# JWT Secret para autenticação do backend
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=5m

# Porta onde a aplicação rodará
PORT=8080

# Conexão MongoDB
# Para desenvolvimento local: mongodb://localhost:27017/xls_fusion
# Para Docker: mongodb://root:example@mongo:27017/xls_fusion?authSource=admin
MONGO_URI=mongodb://localhost:27017/xls_fusion

# Ambiente da aplicação (development/production)
NODE_ENV=development

# Indica se está rodando em container Docker
DOCKER_CONTAINER=false

# --- Configurações de SMTP (Opcional - Ethereal será usado como fallback para testes) ---
# Você pode usar um serviço gratuito de SMTP para enviar e-mails reais.
# Exemplo de Provedores Gratuitos:
# 
# 1. Brevo (antigo Sendinblue) - Oferece 300 e-mails grátis por dia
#    SMTP_HOST=smtp-relay.brevo.com
#    SMTP_PORT=587
#    SMTP_USER=seu_email_cadastrado_no_brevo
#    SMTP_PASS=sua_chave_smtp_key_brevo
#    SMTP_FROM=seu_email_remetente_autorizado
#
# 2. Gmail (Requer 2FA ativo e geração de "Senha de App")
#    SMTP_HOST=smtp.gmail.com
#    SMTP_PORT=587
#    SMTP_USER=seu_usuario@gmail.com
#    SMTP_PASS=sua_senha_de_app_de_16_digitos
#    SMTP_FROM=seu_usuario@gmail.com
#
# 3. Resend - Oferece 3.000 e-mails/mês (100 por dia)
#    SMTP_HOST=smtp.resend.com
#    SMTP_PORT=465 ou 587
#    SMTP_USER=resend
#    SMTP_PASS=sua_api_key_do_resend
#    SMTP_FROM=onboarding@resend.dev (ou seu domínio verificado)

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
