FROM node:20-slim

WORKDIR /app

# Instalar dependências necessárias para compilação se houver libs nativas
RUN apt-get update && apt-get install -y python3 make g++ && rm -rf /var/lib/apt/lists/*

COPY package*.json ./

# Instalamos tudo (incluindo devDependencies para o build)
RUN npm install

COPY . .

# Gera a pasta /dist com o código JavaScript puro
RUN npm run build

# O Cloud Run exige a porta 8080
ENV PORT=8080
EXPOSE 8080

# COMANDO DE PRODUÇÃO: Roda o JS compilado, não o TS original.
# Como o seu index.ts está em src/server/index.ts, 
# o build geralmente o coloca em dist/server/index.js
CMD ["node", "dist/server/index.js"]